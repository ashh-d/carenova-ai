# Google Gemini API key (required)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Model selection
GEMINI_MODEL=gemini-2.5-flash

# Whisper model size: tiny, base, small, medium, large
WHISPER_MODEL=base

# Edge-TTS voice names (see: https://speech.platform.bing.com/consumer/speech/synthesize/readaloud/voices/list)
TTS_VOICE_EN=en-IN-NeerjaNeural
TTS_VOICE_HI=hi-IN-SwaraNeural
TTS_VOICE_MR=mr-IN-AarohiNeural

# Privacy: set to "true" to enable conversation logging
ENABLE_LOGGING=false
